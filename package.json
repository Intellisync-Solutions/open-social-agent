{
  "name": "open-social-agent",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "turbo run dev --filter=@open-social-agent/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p convex/tsconfig.json",
    "test": "turbo run test",
    "test:browser": "playwright test",
    "verify:governance": "node scripts/verify-governance.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.1",
    "@convex-dev/auth": "^0.0.94",
    "convex": "^1.43.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.0",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild"
    ]
  }
}
