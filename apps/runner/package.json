    "@open-social-agent/contracts": "workspace:*",
    "@open-social-agent/secrets": "workspace:*",
    "fastify": "^5.11.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
