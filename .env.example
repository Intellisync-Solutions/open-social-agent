# Public Convex development URLs. Never commit a deployment identifier or provider key.
NEXT_PUBLIC_CONVEX_URL=https://your-development.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-development.convex.site

# Local runner. The runner always binds to 127.0.0.1; this is the only browser
# origin allowed to call it.
OSA_WEB_ORIGIN=http://localhost:3000
OSA_RUNNER_PORT=43117
NEXT_PUBLIC_OSA_RUNNER_URL=http://localhost:43117

# Paid provider generation is disabled unless the operator opts in for a run.
# OSA_ENABLE_GENERATION=1

# Consequential browser execution is independently disabled. Enabling it does
# not bypass the requirement for a fresh exact approval and an explicit process
# request through the paired local runner.
# OSA_ENABLE_COMPUTER=1

# Optional encrypted-file fallback when the OS keychain is unavailable.
# Generate 32 random bytes and encode them as base64; never commit the value.
# OSA_SECRET_STORE=encrypted-file
# LOCAL_SECRET_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
